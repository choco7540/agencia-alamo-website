{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agencia-alamo",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  
  "no_bundle": true,
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agencia-alamo-leads",
      "database_id": "fc2dff05-6cb6-41ac-9d5b-e8a7eeb43335"
    }
  ],
  "observability": {
    "enabled": true
  }
}
